# Copy to .env at the repo root. Task reads it via `dotenv:` and exports every
# value below into the environment of every task, which is how web/ and agent/
# both see them without either one owning the file.

# Matches the credentials baked into docker-compose.yml. The host-side apps use
# localhost; anything running inside compose would use `postgres` instead.
DATABASE_URL=postgres://journal:journal@localhost:5432/journal

# Auth.js signs and encrypts the session cookie with this. Generate your own:
#   openssl rand -base64 32
AUTH_SECRET=

# Where the app believes it lives. Auth.js builds its callback URLs from this,
# so it has to match the origin in the browser or the OAuth round trip fails.
AUTH_URL=http://localhost:3000

# GitHub OAuth app credentials. Create one at
# https://github.com/settings/developers with the callback URL set to
# http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
