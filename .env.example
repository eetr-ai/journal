# Copy to .env at the repo root. Task reads it via `dotenv:` and exports every
# value into the environment of every task, so no module owns the file.

#### postgres ####
# These match the credentials in docker-compose.yml. Change them in both places
# or the container and the apps stop agreeing.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=journal
POSTGRES_PASSWORD=journal
POSTGRES_DB=journal

# The same connection spelled as a URL. Kept alongside the parts above rather
# than derived from them: Task does not interpolate one dotenv value into another.
DATABASE_URL=postgres://journal:journal@localhost:5432/journal
# Octo's connector wants sslmode spelled out for a local container.
POSTGRES_DSN=postgres://journal:journal@localhost:5432/journal?sslmode=disable

#### auth.js ####
# Signs and encrypts the session cookie. Sessions are JWTs, so nothing is stored
# in Postgres. Generate your own:
#   openssl rand -base64 32
AUTH_SECRET=

# Where the app believes it lives. OAuth callback URLs are built from it, so it
# has to match the origin in the browser.
AUTH_URL=http://localhost:3000

# The OIDC client registered at https://auth.eetr.app, whose redirect URI must
# be http://localhost:3000/api/auth/callback/eetr — the last segment is the
# provider id in web/src/auth.ts.
AUTH_OIDC_ID=
AUTH_OIDC_SECRET=

#### redis ####
# Leases, leader election, and the queues and topics the platform sidecar serves
# to the agent. Nothing durable lives here.
#
# The password is its own variable rather than part of the URL, because a base64
# password containing a slash would end the URI's authority and point the client
# somewhere else. The local compose Redis needs none.
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=

# Encrypts what octo writes to its own *_secrets namespaces — a connector
# credential a flow parked, not anything a person wrote. Leave it empty locally
# and those values are stored in the clear, which the sidecar says out loud on
# startup. Generate your own:
#   openssl rand -base64 32
SECRETS_KEY=

#### services ####
# Where the BFF reaches the octo agent. Unset falls back to this, which is what
# `task dev` starts; in the cluster the chart points it at the agent service.
AGENT_URL=http://localhost:8080

#### model providers ####
# https://openrouter.ai/keys
# Two things use this: the agent, to answer, and the platform sidecar, to embed
# what the agent remembers. Unset, the agent will not start and memory search
# falls back to matching text.
OPENROUTER_API_KEY=

# Which model answers, vendor-prefixed the way OpenRouter publishes ids.
CHAT_MODEL=deepseek/deepseek-v4.1-flash

# https://platform.parallel.ai
PARALLEL_API_KEY=
